<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>SUELTA_TITLE</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <background file="background.png" alignment="bottomleft" scaling="none"/>
    <background-darkAqua file="background.png" alignment="bottomleft" scaling="none"/>
    <options customize="always" require-scripts="false" rootVolumeOnly="true" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true"/>
    <volume-check>
        <allowed-os-versions><os-version min="26.0"/></allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="app"/>
        <line choice="lang_es"/>
        <line choice="lang_en"/>
    </choices-outline>
    <choice id="app" title="APP_TITLE" description="APP_DESC" start_enabled="false" enabled="false" selected="true">
        <pkg-ref id="com.bryanchavez.suelta.app"/>
    </choice>
    <!-- Español y English se excluyen: al marcar English se desmarca Español, y al revés. -->
    <choice id="lang_es" title="LANG_ES_TITLE" description="LANG_ES_DESC" start_selected="true" selected="!choices.lang_en.selected">
        <pkg-ref id="com.bryanchavez.suelta.lang.es"/>
    </choice>
    <choice id="lang_en" title="LANG_EN_TITLE" description="LANG_EN_DESC" start_selected="false">
        <pkg-ref id="com.bryanchavez.suelta.lang.en"/>
    </choice>
    <pkg-ref id="com.bryanchavez.suelta.app">SueltaApp.pkg</pkg-ref>
    <pkg-ref id="com.bryanchavez.suelta.lang.es">LangES.pkg</pkg-ref>
    <pkg-ref id="com.bryanchavez.suelta.lang.en">LangEN.pkg</pkg-ref>
</installer-gui-script>
